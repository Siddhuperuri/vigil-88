# Copy to .env (gitignored) and fill in. Every secret-bearing variable VIGIL-88 reads is listed here.
# Never commit a real .env. Values below are intentionally empty placeholders.

# Bearer token for the HTTP API. Required (>=32 chars) if api.bind_host is not loopback. (P1+)
VIGIL_API_TOKEN=

# RTSP credentials are referenced by variable NAME from a camera's source config
# (source.username_env / source.password_env), never written into a URL. (P1+)
# CAM_NORTH_USERNAME=
# CAM_NORTH_PASSWORD=
